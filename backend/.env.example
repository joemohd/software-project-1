# MongoDB database instance connection string
MONGODB_URI="team-mongodb-atlas-connection-string"

# Cloud storage connection string
CLOUDINARY_URL="cloudinary://api-key:api-secret@cloud-name"

# Authentication
# Secret used to sign JWTs. Required: the app won't start without it.
# Generate your own (128 hex chars) and never commit or share it:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
# Access token lifetime in seconds (default 900 = 15 minutes)
JWT_EXPIRES_IN_SECONDS=900
# Session expires after this many seconds without activity (default 1800 = 30 minutes, ACC-06)
REFRESH_TOKEN_IDLE_SECONDS=1800
# Frontend address: used for CORS and for the links in verification / password-reset emails
FRONTEND_URL="http://localhost:3001"
# Auth cookies are Secure by default (ACC-19). Set to false only if a local HTTP tool drops them.
COOKIE_SECURE=true

# ---- Email (SMTP, GEN-01-B) ----
# Leave SMTP_HOST empty in development to use a throwaway Ethereal test inbox:
# each email's preview URL is printed in the server log. Required in production.
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Travel Planner <no-reply@travel-planner.local>"

# ---- Payments (Stripe test mode, PAY-01) ----
# Test secret key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_). Never commit the real one.
STRIPE_SECRET_KEY="sk_test_replace-with-your-test-key"
# Webhook signing secret (starts with whsec_). Locally: run `stripe listen --forward-to localhost:3000/api/payments/webhook`
# and copy the secret it prints. Optional for Swagger testing with testPaymentMethod.
STRIPE_WEBHOOK_SECRET=
